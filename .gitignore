# 依赖
node_modules/

# 本机运行产生的配置：
#   config.json        —— 位置 / 大小 / 置顶 / 形象
#   usage.json         —— 装了哪些插件、信息条显示哪些字段
#   usage-history.json —— 每日用量账本（用量面板画趋势用）
# 这三份是「这台机器上的选择 / 这台机器上的用量」，不该跟着仓库走。
config.json
usage.json
usage-history.json

# 验收脚本的产出（截图 + 启动报告），重跑脚本会重新生成
tools/startup-report.json
tools/probe-hit-report.txt
tools/*.png
tools/ab/

# 素材工具的一次性中间产物：抠好的透明贴纸。57 帧 + states/ + 托盘图标是入库的，
# 这几张随时能从 _source*.png 重跑出来（见 tools/make-shayu-sticker.py）。
assets/shayu/_sticker*.png

# 素材/验收脚本顺带写出的质检图（接触印相表、掩膜对照、清洁前后）
tools/_*

# 系统
Thumbs.db
.DS_Store
desktop.ini

# Python 跑 tools/*.py 时留下的字节码缓存
__pycache__/
*.pyc
